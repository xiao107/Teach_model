# Teach_model 环境变量示例
# 复制本文件为 .env 并填入真实值（.env 含密钥，切勿提交到 git / 打包分发）

# DeepSeek API 密钥（必填）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# 模型（默认 deepseek-chat）
DEEPSEEK_MODEL=deepseek-chat

# LLM 请求超时（秒）
LLM_TIMEOUT_S=60

# CORS 允许来源（逗号分隔）
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# 日志级别
LOG_LEVEL=INFO

# 上传限制
UPLOAD_MAX_BYTES=10485760

# 每分钟每 IP 的对话请求数上限
RATE_LIMIT_PER_MINUTE=20
